<?xml version="1.0" encoding="utf-8"?>
<!-- Backup and device transfer on Android 12 and higher. Everything else is
     still backed up. Keep in sync with backup_rules.xml. -->
<data-extraction-rules>
    <cloud-backup>
        <!-- The Hive boxes: the encrypted ones' key stays in the device's
             Keystore, so a restored copy could never be read. -->
        <exclude domain="file" path="hive" />
        <!-- flutter_secure_storage, which holds that key. -->
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
        <exclude domain="sharedpref" path="FlutterSecureStorageConfiguration.xml" />
    </cloud-backup>
    <device-transfer>
        <!-- The Hive boxes: the encrypted ones' key stays in the device's
             Keystore, so a restored copy could never be read. -->
        <exclude domain="file" path="hive" />
        <!-- flutter_secure_storage, which holds that key. -->
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
        <exclude domain="sharedpref" path="FlutterSecureStorageConfiguration.xml" />
    </device-transfer>
</data-extraction-rules>
