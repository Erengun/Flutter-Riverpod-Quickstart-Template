# fastlane for the release workflow (.github/workflows/release.yaml). The
# lanes live in app/android/fastlane/ and app/ios/fastlane/; run them from
# those folders with `bundle exec fastlane <lane>`. Bundler finds this file by
# walking up from there. Dependabot keeps Gemfile.lock up to date.
source "https://rubygems.org"

gem "fastlane", "~> 2.241"
